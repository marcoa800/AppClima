# Copia este fichero a .env y rellena lo que necesites.
# Solo eBird requiere token en la fase 1. Open-Meteo y USGS son abiertos.

# eBird API 2.0 — token gratis e instantáneo en https://ebird.org/api/keygen
# Sin token, la ingesta de aves se salta con un aviso (no rompe el pipeline).
APPCLIMA_EBIRD_TOKEN=

# Raíz del lakehouse. Por defecto ./data
# APPCLIMA_DATA_DIR=./data

# User-Agent enviado a las APIs. Buena práctica y obligatorio en MET Norway.
# APPCLIMA_USER_AGENT=AppClima/0.1 (contacto@ejemplo.com)
